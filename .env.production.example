SERVICE_NAME=github-events-ingestor
ENVIRONMENT=production
LOG_LEVEL=info
HTTP_ADDR=:8080
INGESTOR_HOST_BIND=0.0.0.0
CONSUMER_SERVICE_NAME=github-events-consumer
CONSUMER_HTTP_ADDR=:8081
CONSUMER_HOST_BIND=0.0.0.0
FRONTEND_HOST_BIND=127.0.0.1
PROMETHEUS_HOST_BIND=127.0.0.1
GRAFANA_HOST_BIND=127.0.0.1
CADDY_HTTP_HOST_BIND=0.0.0.0
CADDY_ADMIN_HOST_BIND=127.0.0.1

GITHUB_EVENTS_API_URL=https://api.github.com/events
GITHUB_TOKEN=
GITHUB_USER_AGENT=github-pulse-ingestor

POLL_INTERVAL=15s
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s

KAFKA_BROKERS=redpanda:9092
KAFKA_TOPIC_GITHUB_EVENTS=github.events.raw.v1
KAFKA_CLIENT_ID=github-events-ingestor
CONSUMER_KAFKA_CLIENT_ID=github-events-consumer
KAFKA_GROUP_ID=github-events-consumer

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
IDEMPOTENCY_TTL=72h
TRENDING_WINDOW_SIZE=5m
TRENDING_WINDOW_TTL=2h
TRENDING_LIMIT=10

POSTGRES_DB=github_pulse
POSTGRES_USER=github_pulse
POSTGRES_PASSWORD=change-me-before-deploy
POSTGRES_ENABLED=true
POSTGRES_DSN=postgres://github_pulse:change-me-before-deploy@postgres:5432/github_pulse?sslmode=disable
PERSISTENCE_QUEUE_SIZE=1000
PERSISTENCE_WORKERS=1
REPLAY_MODE=false
REPLAY_RATE_LIMIT=0
REPLAY_MAX_MESSAGES=0
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_MAX_CONNECTIONS=50

REDPANDA_MEMORY=768M
REDPANDA_MEM_LIMIT=1g
REDPANDA_CPUS=1.0
REDIS_MAXMEMORY=128mb
REDIS_MEM_LIMIT=192m
REDIS_CPUS=0.25
POSTGRES_MEM_LIMIT=512m
POSTGRES_CPUS=0.5
INGESTOR_MEM_LIMIT=128m
INGESTOR_CPUS=0.25
CONSUMER_MEM_LIMIT=128m
CONSUMER_CPUS=0.25
FRONTEND_MEM_LIMIT=256m
FRONTEND_CPUS=0.5
PROMETHEUS_RETENTION=15d
PROMETHEUS_EXTERNAL_URL=/prometheus/
PROMETHEUS_MEM_LIMIT=384m
PROMETHEUS_CPUS=0.5
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-deploy
GRAFANA_ROOT_URL=%(protocol)s://%(domain)s/grafana/
GRAFANA_ANONYMOUS_ENABLED=false
GRAFANA_MEM_LIMIT=256m
GRAFANA_CPUS=0.5
REDIS_EXPORTER_MEM_LIMIT=64m
REDIS_EXPORTER_CPUS=0.1
POSTGRES_EXPORTER_MEM_LIMIT=64m
POSTGRES_EXPORTER_CPUS=0.1
KAFKA_EXPORTER_MEM_LIMIT=96m
KAFKA_EXPORTER_CPUS=0.1
CADDY_MEM_LIMIT=128m
CADDY_CPUS=0.25
BENCH_EVENTS=1000
BENCH_RATE=100
BENCH_REPOS=100
BENCH_BATCH_SIZE=100
BENCH_PREFIX=bench
