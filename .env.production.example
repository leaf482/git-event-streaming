SERVICE_NAME=github-events-ingestor
ENVIRONMENT=production
LOG_LEVEL=info
HTTP_ADDR=:8080
INGESTOR_HOST_BIND=0.0.0.0
CONSUMER_SERVICE_NAME=github-events-consumer
CONSUMER_HTTP_ADDR=:8081
CONSUMER_HOST_BIND=0.0.0.0
FRONTEND_HOST_BIND=0.0.0.0

GITHUB_EVENTS_API_URL=https://api.github.com/events
GITHUB_TOKEN=
GITHUB_USER_AGENT=github-pulse-ingestor

POLL_INTERVAL=15s
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s

KAFKA_BROKERS=redpanda:9092
KAFKA_TOPIC_GITHUB_EVENTS=github.events.raw.v1
KAFKA_CLIENT_ID=github-events-ingestor
CONSUMER_KAFKA_CLIENT_ID=github-events-consumer
KAFKA_GROUP_ID=github-events-consumer

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
IDEMPOTENCY_TTL=72h
TRENDING_WINDOW_SIZE=5m
TRENDING_WINDOW_TTL=2h
TRENDING_LIMIT=10

POSTGRES_DB=github_pulse
POSTGRES_USER=github_pulse
POSTGRES_PASSWORD=change-me-before-deploy
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_MAX_CONNECTIONS=50

REDPANDA_MEMORY=768M
REDPANDA_MEM_LIMIT=1g
REDPANDA_CPUS=1.0
REDIS_MAXMEMORY=128mb
REDIS_MEM_LIMIT=192m
REDIS_CPUS=0.25
POSTGRES_MEM_LIMIT=512m
POSTGRES_CPUS=0.5
INGESTOR_MEM_LIMIT=128m
INGESTOR_CPUS=0.25
CONSUMER_MEM_LIMIT=128m
CONSUMER_CPUS=0.25
FRONTEND_MEM_LIMIT=256m
FRONTEND_CPUS=0.5
